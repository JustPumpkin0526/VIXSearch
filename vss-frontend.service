[Unit]
Description=VSS Frontend Service (Vue.js)
After=network.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/path/to/VSS_Project
ExecStart=/usr/bin/npm run dev
Restart=on-failure
RestartSec=10
StandardOutput=append:/path/to/VSS_Project/logs/frontend-service.log
StandardError=append:/path/to/VSS_Project/logs/frontend-service-error.log

# 환경 변수
Environment="NODE_ENV=development"
Environment="PATH=/usr/bin:/usr/local/bin"

[Install]
WantedBy=multi-user.target
