name: "gdino_postprocess"
backend: "python"
max_batch_size: 8
input [
{
    name: "pred_logits"
    data_type: TYPE_FP32
    dims: [ -1, 256]
},
{
    name: "pred_boxes"
    data_type: TYPE_FP32
    dims: [ -1, 4]
}
,
{
    name: "pos_map"
    data_type: TYPE_FP32
    dims: [ -1,256]
}
,
{
    name: "target_sizes"
    data_type: TYPE_INT32
    dims: [4]
}
]

output [
{
    name: "labels"
    data_type: TYPE_INT32
    dims: [ -1,-1]
},
{
    name: "boxes"
    data_type: TYPE_FP32
    dims: [ -1,-1, 4]
}
,
{
    name: "scores"
    data_type: TYPE_FP32
    dims: [ -1,-1]
}
]

instance_group [
    {
      count: 1
      kind: KIND_CPU
    }
]

parameters: { key: "FORCE_CPU_ONLY_INPUT_TENSORS" value: {string_value:"yes"}}