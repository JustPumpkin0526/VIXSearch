[Unit]
Description=VSS Backend Service (FastAPI)
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/path/to/VSS_Project/src/api
ExecStart=/usr/bin/python3 main.py
Restart=on-failure
RestartSec=10
StandardOutput=append:/path/to/VSS_Project/logs/backend-service.log
StandardError=append:/path/to/VSS_Project/logs/backend-service-error.log

# 환경 변수
Environment="PYTHONUNBUFFERED=1"
Environment="PATH=/usr/bin:/usr/local/bin"

[Install]
WantedBy=multi-user.target
